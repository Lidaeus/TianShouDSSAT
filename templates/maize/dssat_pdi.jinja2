logging:
  level: error

metadata:
  NLAYR: int

data:
  PDI_EARLY_STOPPING: logical
  RSEED1: int
  ANFER: float
  AMIR: float
  YRDOY: int
  NSTRES: float
  ISTAGE: int
  VSTAGE: float
  GRNWT: float
  TOPWT: float
  PLTPOP: float
  SWFAC: float
  PCNGRN: float
  TLeachD: float
  TNOXD: float
  WTNUP: float
  CLeach: float
  CNOX: float
  CumSumFert: float
  XLAI: float
  TRNU: float
  RAIN: float
  TMIN: float
  TMAX: float
  SRAD: float
  DTT: float
  DAP: int
  ES: float
  EO: float
  EOP: float
  EOS: float
  EP: float
  RUNOFF: float
  WTDEP: float
  RTDEP: float
  TOTAML: float
  TOTIR: float
  LL:
    type: array
    subtype: float
    size: '$NLAYR'
  DUL:
    type: array
    subtype: float
    size: '$NLAYR'
  DLAYR:
    type: array
    subtype: float
    size: '$NLAYR'
    size: '$NLAYR'
  SW:
    type: array
    subtype: float
    size: '$NLAYR'
  DS:
    type: array
    subtype: float
    size: '$NLAYR'
  SAT:
    type: array
    subtype: float
    size: '$NLAYR'

plugins:
  pycall:
    on_data:
      YRDOY: |
        yrdoy = YRDOY
      NSTRES: |
        nstres = NSTRES
      ISTAGE: |
        istage = ISTAGE
      VSTAGE: |
        vstage = VSTAGE
      GRNWT: |
        grnwt = GRNWT
      TOPWT: |
        topwt = TOPWT
      PLTPOP: |
        pltpop = PLTPOP
      SWFAC: |
        swfac = SWFAC
      PCNGRN: |
        pcngrn = PCNGRN
      TLeachD: |
        tleachd = TLeachD
      TNOXD: |
        tnoxd = TNOXD
      WTNUP: |
        wtnup = WTNUP
      CLeach: |
        cleach = CLeach
      CNOX: |
        cnox = CNOX
      CumSumFert: |
        cumsumfert = CumSumFert
      XLAI: |
        xlai = XLAI
      TRNU: |
        trnu = TRNU
      RAIN: |
        rain = RAIN
      TMIN: |
        tmin = TMIN
      TMAX: |
        tmax = TMAX
      SRAD: |
        srad = SRAD
      DTT: |
        dtt = DTT
      DAP: |
        dap = DAP
      LL: |
        ll = LL
      DUL: |
        dul = DUL
      SW: |
        sw = SW
      ES: |
        es = ES
      EO: |
        eo = EO
      EOS: |
        eos = EOS
      EOP: |
        eop = EOP
      EP: |
        ep = EP
      RUNOFF: |
        runoff = RUNOFF
      WTDEP: |
        wtdep = WTDEP
      SAT: |
        sat = SAT
      DLAYR: |
        dlayr = DLAYR
      RTDEP: |
        rtdep = RTDEP
      TOTAML: |
        totaml = TOTAML
      TOTIR: |
        totir = TOTIR
    on_event:
      start_client:
        exec: |
          import sys
          import os
          import zmq
          import json
          import logging
          import numpy as np
          class NumpyEncoder(json.JSONEncoder):
            def default(self, obj):
              if isinstance(obj, np.ndarray):
                return obj.tolist()
              elif hasattr(obj, 'dtype'):
                return obj.item()
              return json.JSONEncoder.default(self, obj)
          context = zmq.Context()
          client = context.socket(zmq.PAIR)
          client.connect('tcp://localhost:{{ port }}')
          done = False
          rseed1_ = {{ rseed1 }}
          is_early_stopping = False
          print('Maize Client started')
      flag_done:
        exec: |
          done = True
          message = {'done': done, 'state': {}}
          client.send(json.dumps(message, cls=NumpyEncoder).encode('utf-8'))
          rseed1_ = client.recv().decode('utf-8')
      interact:
        exec: |
          state = {'yrdoy': yrdoy, 'nstres': nstres, 'istage': istage, 'vstage': vstage,
          'grnwt': grnwt, 'topwt': topwt, 'pltpop': pltpop, 'swfac': swfac, 'pcngrn': pcngrn,
          'tleachd': tleachd, 'tnoxd': tnoxd, 'wtnup': wtnup, 'cleach': cleach, 'cnox': cnox,
          'cumsumfert': cumsumfert, 'xlai': xlai, 'trnu': trnu, 'rain': rain, 'tmin': tmin,
          'tmax': tmax, 'srad': srad, 'dtt': dtt, 'dap': dap, 'll': ll, 'dul': dul, 'sw': sw,
          'es': es, 'eo': eo, 'eop': eop, 'eos': eos, 'ep': ep, 'runoff': runoff, 'wtdep': wtdep,
          'sat': sat, 'rtdep': rtdep, 'dlayr': dlayr, 'totaml': totaml, 'totir': totir }
          message = {'done':done, 'state':state}
          client.send(json.dumps(message, cls=NumpyEncoder).encode('utf-8'))
          response = json.loads(client.recv().decode('utf-8'))
          action = response['action']
          is_early_stopping = response['early_stopping']
      fertilize:
        with: {anfer: $ANFER}
        exec: |
          anfer[()] = action['anfer']
      irrigate:
        with: {amir: $AMIR}
        exec: |
          amir[()] = action['amir']
      set_rseed:
        with: {rseed1: $RSEED1}
        exec: |
          rseed1[()] = rseed1_
      early_stopping:
        with: {pdi_early_stopping: $PDI_EARLY_STOPPING}
        exec: |
          pdi_early_stopping[()] = is_early_stopping
